# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI model. Set one key. Gemini has a free tier.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: use Claude instead of Gemini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
# AI_PROVIDER=anthropic

# Optional
# PORT=3000
# BRAND_NAME=SmartPay Demo Store
# AI_TIMEOUT_MS=15000
# ROUTE_RATE_LIMIT=30
